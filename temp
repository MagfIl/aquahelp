name: Deploy to GitHub Pages

on:
  push:
    branches: 'gpages' # Скрипт сработает при пуше в gpages

# Разрешаем скрипту собирать и публиковать сайт на GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: 'pages'
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Install dependencies
        # Добавили флаг, чтобы обойти конфликт версий esbuild и Vite 8
        run: npm ci --legacy-peer-deps 

      - name: Build
        run: npm run build # Vite собирает калькулятор «Суздаль АКВА» в папку dist

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: './dist' # Передаем сборку для публикации

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
